# Local secrets and machine-specific settings (generated by `churnctl bootstrap`).
.env
.dvc/config.local

# Python tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.tools/

# Pipeline data is versioned by DVC (dvc.lock + MinIO remote), not by Git: DVC writes the
# matching ignore entries into data/**/.gitignore itself. Small JSON reports in reports/
# are Git-tracked DVC outputs (cache: false) so their diffs are reviewable.

# Scratch output from local runs
/.runtime/
*.log
