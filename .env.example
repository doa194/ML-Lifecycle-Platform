# Local credentials for the Docker Compose stack and the host CLI.
# `churnctl bootstrap` copies this file to `.env` and replaces every "change-me"
# with a random secret. `.env` is git-ignored; never commit real values.

COMPOSE_PROJECT_NAME=churn-platform

# PostgreSQL: one server, separate roles per component (least privilege).
POSTGRES_SUPERUSER_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
OPS_DB_PASSWORD=change-me
INFERENCE_DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me

# MinIO: the root account is only used by the one-shot `minio-init` container.
# MLflow and DVC each get their own account limited to their own bucket.
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me
MLFLOW_S3_ACCESS_KEY=mlflow-artifacts
MLFLOW_S3_SECRET_KEY=change-me
DVC_S3_ACCESS_KEY=dvc-remote
DVC_S3_SECRET_KEY=change-me

GRAFANA_ADMIN_PASSWORD=change-me
