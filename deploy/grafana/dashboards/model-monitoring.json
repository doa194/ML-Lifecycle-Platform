          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Production performance over time",
      "description": "Delayed signal: only computed once outcomes are resolved.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "churn-ops"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "churn-ops"
          },
          "rawSql": "SELECT finished_at AS \"time\", (performance->>'f1')::float AS \"production F1\", (performance->>'recall')::float AS \"production recall\", (performance->>'roc_auc')::float AS \"production ROC-AUC\", (reference_performance->>'f1')::float AS \"test F1 (reference)\" FROM ops.monitoring_runs WHERE model_name = '$model' AND performance IS NOT NULL AND $__timeFilter(finished_at) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Continuous training and lifecycle",
      "collapsed": false,
      "gridPos": {
        "h": 1,
