        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Test F1 at training time",
      "description": "The same model's F1 on its held-out test period. Note: F1 also moves with the churn rate.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "churn-ops"
      },
      "gridPos": {
        "h": 4,
