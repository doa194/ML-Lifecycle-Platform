            "uid": "churn-ops"
          },
          "rawSql": "SELECT (performance->>'roc_auc')::float AS roc_auc FROM ops.monitoring_runs WHERE model_name = '$model' ORDER BY finished_at DESC LIMIT 1",
          "format": "table",
