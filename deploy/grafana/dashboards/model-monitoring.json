      "panels": []
    },
    {
      "id": 17,
      "type": "table",
      "title": "Retraining requests",
      "description": "Requests created by the monitoring policy or an operator, and what the controller did.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "churn-ops"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "churn-ops"
          },
          "rawSql": "SELECT created_at AS created, trigger, status, outcome, data_as_of::text AS data_as_of, candidate_version AS candidate, champion_version_before AS champion_before, champion_version_after AS champion_after, attempts, reasons::text AS reasons FROM ops.retraining_requests WHERE model_name = '$model' ORDER BY created_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Lifecycle audit trail",
      "description": "Registrations, gate results, promotions and rollbacks (the registry holds the current state).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "churn-ops"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "churn-ops"
          },
          "rawSql": "SELECT occurred_at AS time, 'v' || model_version AS version, event_type AS event, actor, details::text AS details FROM ops.lifecycle_events WHERE model_name = '$model' ORDER BY event_id DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
