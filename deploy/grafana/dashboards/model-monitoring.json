      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Production ROC-AUC",
      "description": "Ranking quality; less sensitive to the churn rate than F1.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "churn-ops"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
