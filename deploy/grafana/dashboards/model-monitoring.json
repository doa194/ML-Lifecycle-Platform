      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Production F1",
      "description": "F1 of the predictions actually served (empty until enough outcomes are resolved).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "churn-ops"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "churn-ops"
          },
          "rawSql": "SELECT (performance->>'f1')::float AS f1 FROM ops.monitoring_runs WHERE model_name = '$model' ORDER BY finished_at DESC LIMIT 1",
